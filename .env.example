# Public Vite variables.
# Set VITE_TURSO_CONFIGURED=true so the React app calls the Cloudflare Pages Functions API.
VITE_TURSO_CONFIGURED=true

# Optional local development proxy.
# Keep this only when running Cloudflare Pages Functions locally with Wrangler.
VITE_API_BASE=http://localhost:8788

# Cloudflare Pages Functions server-side variables.
# Add these as environment variables/secrets in Cloudflare Pages.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# AI chat Edge Function secret.
GEMINI_API_KEY=your-gemini-api-key

# GitHub Contributions Edge Function secret.
GITHUB_TOKEN=your-github-token-with-read-access

# Admin login credentials used by /admin-login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
